# Keep edited source files LF in the working tree so edits don't create mixed
# line endings that Git would otherwise store verbatim (ballooning diffs).
*.dart text eol=lf
*.rs   text eol=lf
*.py   text eol=lf

# Flutter regenerates these with LF on every build; pin eol=lf so autocrlf
# doesn't reintroduce a CRLF/LF-only diff each time. Match every app: the paths
# used to name `apps/goresave` and silently stopped applying when it became
# `apps/save-editor`, which is why these kept showing up as modified.
apps/*/windows/flutter/generated_plugin_registrant.cc text eol=lf
apps/*/windows/flutter/generated_plugin_registrant.h  text eol=lf
apps/*/windows/flutter/generated_plugins.cmake        text eol=lf
