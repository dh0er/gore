    "visual_findings": [
      {
        "textures": [
          "T_NH_Head_D",
          "T_NH_head_WM1_D",
          "T_NH_head_WM2_D"
        ],
        "finding": "All three stock albedo images visibly contain the painted lower-face beard and moustache."
      },
      {
        "textures": [
          "T_NH_Head_N",
          "T_NH_head_WM1_N",
          "T_NH_head_WM2_N"
        ],
        "finding": "Original-resolution visual inspection shows facial pores and expression folds, with no clearly visible coarse beard strands or sharp beard outline. This is visual evidence, not proof of zero microscopic beard contribution."
      },
      {
        "textures": [
          "T_GCom_Milten_Head_MRAOT",
          "T_G21_HM_Std_Young_Sweaty_Head_MRAOT",
          "T_G21_HM_Std_Young_Head_SS"
        ],
        "finding": "Hero instance uses shared skin mask textures. Exported images show skin/sweat/subsurface patterns without a visible beard-shaped region. Exact packed-channel shader routing was not decoded."
      },
      {
        "textures": [
          "T_OC_IE_Flex_Head_D"
        ],
        "finding": "Stock Flex head albedo is visibly clean-shaven."
      }
    ],
    "implementation_conclusions": [
      "Use exact global texture parameter name 1 - Albedo (Alpha Cutout) on each NPC head MID.",
      "Hero clean mode should also override 5 - WM1 Albedo and 6 - WM2 Albedo to prevent the stock painted beard returning through animated albedo.",
      "Using the same clean image for all three Hero albedo slots removes animated albedo color variation; preserving the original three normal maps retains their wrinkle normal detail.",
      "The exact base-normal name has TWO spaces: 2 - Base  Normal. Its replacement is not supported as necessary by the inspected images.",
      "Hero has no explicit Animated Albedo or Animated Normals override in its MI. Parent defaults and final shader activation were not established by this property-only decoder.",
      "Flex explicitly overrides Animated Albedo=false and Animated Normals=false and has no instance WM texture overrides.",
      "Separate MI_NH_Beard hair cards use RAD (Root, Alpha, Depth) and SIAO (Specular, ID, Ambient Occlusion); hiding those cards is independent of removing the head albedo beard."
    ],
